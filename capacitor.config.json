{
  "appId": "ae.morningbox.app",
  "appName": "Morning Box",
  "webDir": "dist",
  "backgroundColor": "#FBF7EF",
  "server": {
    "url": "https://morningbox.ae",
    "cleartext": false,
    "androidScheme": "https",
    "errorPath": "offline.html",
    "allowNavigation": [
      "checkout.stripe.com",
      "*.stripe.com"
    ]
  },
  "android": {
    "webContentsDebuggingEnabled": true,
    "allowMixedContent": false
  },
  "plugins": {
    "SystemBars": {
      "insetsHandling": "css",
      "style": "LIGHT"
    }
  }
}
