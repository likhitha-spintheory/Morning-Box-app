{
  "name": "morning-box-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite",
    "dev:api": "node --watch --import ./scripts/dev-env.mjs server/index.js",
    "build": "vite build",
    "start": "node server/index.js",
    "preview": "vite preview",
    "test": "node --import ./scripts/test-env.mjs --test tests/*.test.js",
    "android": "node scripts/android.mjs",
    "apk": "node scripts/apk.mjs",
    "apk:release": "node scripts/apk.mjs --release",
    "backup": "node scripts/backup.mjs",
    "seed": "node scripts/seed.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.4.3",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.4.3",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/share": "^8.0.2",
    "express": "^4.21.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.4.3",
    "@vitejs/plugin-react": "^4.3.1",
    "vite": "^5.4.8"
  },
  "engines": {
    "node": ">=22.5"
  }
}
